<!DOCTYPE UI><UI version="3.3" stdsetdef="1">
<class>MainWindowDesign</class>
<author>Julien Morot</author>
<widget class="QMainWindow">
    <property name="name">
        <cstring>MainWindowDesign</cstring>
    </property>
    <property name="geometry">
        <rect>
            <x>0</x>
            <y>0</y>
            <width>771</width>
            <height>515</height>
        </rect>
    </property>
    <property name="caption">
        <string>KDHCPD</string>
    </property>
    <widget class="QListView">
        <column>
            <property name="text">
                <string>Parameter</string>
            </property>
            <property name="clickable">
                <bool>true</bool>
            </property>
            <property name="resizable">
                <bool>true</bool>
            </property>
        </column>
        <column>
            <property name="text">
                <string>Value</string>
            </property>
            <property name="clickable">
                <bool>true</bool>
            </property>
            <property name="resizable">
                <bool>true</bool>
            </property>
        </column>
        <column>
            <property name="text">
                <string>Meaning</string>
            </property>
            <property name="clickable">
                <bool>true</bool>
            </property>
            <property name="resizable">
                <bool>true</bool>
            </property>
        </column>
        <property name="name">
            <cstring>listOptions</cstring>
        </property>
        <property name="geometry">
            <rect>
                <x>250</x>
                <y>10</y>
                <width>520</width>
                <height>440</height>
            </rect>
        </property>
    </widget>
    <widget class="QListView">
        <column>
            <property name="text">
                <string>DHCP</string>
            </property>
            <property name="clickable">
                <bool>true</bool>
            </property>
            <property name="resizable">
                <bool>true</bool>
            </property>
        </column>
    <item>
        <property name="text">
            <string>Global options</string>
        </property>
        <property name="pixmap">
            <pixmap></pixmap>
        </property>
    </item>
    <item>
        <property name="text">
            <string>Scope (subnet)</string>
        </property>
        <property name="pixmap">
            <pixmap></pixmap>
        </property>
        <item>
            <property name="text">
                <string>Group</string>
            </property>
            <property name="pixmap">
                <pixmap></pixmap>
            </property>
        </item>
        <item>
            <property name="text">
                <string>Pool</string>
            </property>
            <property name="pixmap">
                <pixmap></pixmap>
            </property>
        </item>
    </item>
    <item>
        <property name="text">
            <string>Statics hosts</string>
        </property>
        <property name="pixmap">
            <pixmap></pixmap>
        </property>
    </item>
        <property name="name">
            <cstring>listStructure</cstring>
        </property>
        <property name="geometry">
            <rect>
                <x>0</x>
                <y>10</y>
                <width>250</width>
                <height>440</height>
            </rect>
        </property>
    </widget>
</widget>
<menubar>
    <property name="name">
        <cstring>MenuBar</cstring>
    </property>
    <item text="&amp;File" name="fileMenu">
        <action name="fileDeleteAction"/>
        <action name="fileSaveAction"/>
        <action name="fileExitAction"/>
    </item>
    <item text="New" name="New">
        <separator/>
        <action name="newStatic_HostAction"/>
        <action name="newScopeAction"/>
        <action name="newGlobal_OptionAction"/>
        <separator/>
        <action name="newPoolAction"/>
        <action name="newGroupAction"/>
    </item>
    <item text="Service" name="Service">
        <action name="serviceStartAction"/>
        <action name="serviceStopAction"/>
        <action name="serviceRestartAction"/>
    </item>
    <item text="&amp;Help" name="helpMenu">
        <action name="helpAboutAction"/>
    </item>
</menubar>
<toolbars>
    <toolbar dock="2">
        <property name="name">
            <cstring>Toolbar</cstring>
        </property>
        <property name="label">
            <string>Toolbar</string>
        </property>
    </toolbar>
</toolbars>
<actions>
    <action>
        <property name="name">
            <cstring>fileSaveAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image0</iconset>
        </property>
        <property name="text">
            <string>Save</string>
        </property>
        <property name="menuText">
            <string>&amp;Save</string>
        </property>
        <property name="accel">
            <string>Ctrl+S</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>fileExitAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image1</iconset>
        </property>
        <property name="text">
            <string>Exit</string>
        </property>
        <property name="menuText">
            <string>E&amp;xit</string>
        </property>
        <property name="accel">
            <string>Ctrl+Q</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>helpAboutAction</cstring>
        </property>
        <property name="text">
            <string>About</string>
        </property>
        <property name="menuText">
            <string>&amp;About</string>
        </property>
        <property name="accel">
            <string></string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>newStatic_HostAction</cstring>
        </property>
        <property name="text">
            <string>Static Host</string>
        </property>
        <property name="menuText">
            <string>Static Host</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>newScopeAction</cstring>
        </property>
        <property name="text">
            <string>Scope</string>
        </property>
        <property name="menuText">
            <string>Scope</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>newGlobal_OptionAction</cstring>
        </property>
        <property name="text">
            <string>Global Option</string>
        </property>
        <property name="menuText">
            <string>Global Option</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>newPoolAction</cstring>
        </property>
        <property name="text">
            <string>Pool</string>
        </property>
        <property name="menuText">
            <string>Pool</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>newGroupAction</cstring>
        </property>
        <property name="text">
            <string>Group</string>
        </property>
        <property name="menuText">
            <string>Group</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>serviceStartAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image2</iconset>
        </property>
        <property name="text">
            <string>Start</string>
        </property>
        <property name="menuText">
            <string>Start</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>serviceStopAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image3</iconset>
        </property>
        <property name="text">
            <string>Stop</string>
        </property>
        <property name="menuText">
            <string>Stop</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>serviceRestartAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image4</iconset>
        </property>
        <property name="text">
            <string>Restart</string>
        </property>
        <property name="menuText">
            <string>Restart</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>fileDeleteAction</cstring>
        </property>
        <property name="text">
            <string>Delete</string>
        </property>
        <property name="menuText">
            <string>Delete</string>
        </property>
    </action>
</actions>
<images>
    <image name="image0">
        <data format="PNG" length="763"></data>
    </image>
    <image name="image1">
        <data format="PNG" length="1343"></data>
    </image>
    <image name="image2">
        <data format="PNG" length="1205"></data>
    </image>
    <image name="image3">
        <data format="PNG" length="1073"></data>
    </image>
    <image name="image4">
        <data format="PNG" length="1363"></data>
    </image>
</images>
<connections>
    <connection>
        <sender>fileSaveAction</sender>
        <signal>activated()</signal>
        <receiver>MainWindowDesign</receiver>
        <slot>fileSave()</slot>
    </connection>
    <connection>
        <sender>fileExitAction</sender>
        <signal>activated()</signal>
        <receiver>MainWindowDesign</receiver>
        <slot>fileExit()</slot>
    </connection>
    <connection>
        <sender>helpAboutAction</sender>
        <signal>activated()</signal>
        <receiver>MainWindowDesign</receiver>
        <slot>helpAbout()</slot>
    </connection>
</connections>
<slots>
    <slot>fileSave()</slot>
    <slot>fileExit()</slot>
    <slot>helpAbout()</slot>
</slots>
<layoutdefaults spacing="6" margin="11"/>
</UI>
